# ============================================================
# Copie este arquivo para .env e preencha os valores
# NÃO commite o .env no git!
# ============================================================

# Banco de Dados — Supabase PostgreSQL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase Client (SDK) — opcional, se usar client-side
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# NextAuth — use o domínio configurado no Coolify (ex: https://europcar.seudominio.com.br)
NEXTAUTH_URL="https://[seu-dominio]"
NEXTAUTH_SECRET=""
# Para gerar: openssl rand -base64 32

# XRS Europcar
# Sandbox:  https://applications-ptn.europcar.com/xrs/resxml
# Produção: https://applications.europcar.com/xrs/resxml
XRS_ENDPOINT_URL="https://applications-ptn.europcar.com/xrs/resxml"
XRS_CALLER_CODE=""
XRS_PASSWORD=""

# Cielo (Pagamento)
CIELO_MERCHANT_ID=""
CIELO_MERCHANT_KEY=""
CIELO_CLIENT_ID=""
CIELO_CLIENT_SECRET=""
CIELO_SANDBOX="true"
